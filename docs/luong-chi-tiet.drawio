        <mxCell id="18" value="PLAN &amp; HEALTH" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#203247;fontStyle=1;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="1170" y="285" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="19" value="POST /subscriptions&#xa;GET /subscriptions/{id}&#xa;DELETE /subscriptions/{id}&#xa;POST /subscriptions/{id}/pause&#xa;POST /subscriptions/{id}/resume&#xa;POST /subscriptions/{id}/renew&#xa;POST /subscriptions/{id}/renewals&#xa;POST /subscriptions/search" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e8f1ff;strokeColor=#3973b7;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="325" width="505" height="260" as="geometry" />
        </mxCell>
        <mxCell id="20" value="GET /subscriptions/{id}/invoices&#xa;GET /invoices/{id}&#xa;POST /invoices/{id}/pay&#xa;POST /invoices/{id}/settle&#xa;POST /invoices/{id}/void&#xa;GET /invoices/{id}/renewal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#fff1dd;strokeColor=#cc8122;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="600" y="325" width="505" height="260" as="geometry" />
        </mxCell>
        <mxCell id="21" value="POST /plans&#xa;GET /plans/{code}&#xa;GET /plans&#xa;&#xa;/health/live · /health/ready · /health&#xa;OpenAPI / Scalar nếu bật cấu hình" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e5f5ec;strokeColor=#31865c;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1160" y="325" width="505" height="260" as="geometry" />
        </mxCell>
        <mxCell id="22" value="ĐỌC / TÌM KIẾM&#xa;GET subscription: cache hit → trả về; miss → DB → cache. Không cache 404.&#xa;Search dùng keyset (start_date, id) DESC + limit+1; cursor / status sai → 400." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a5b2c2;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="640" width="505" height="175" as="geometry" />
        </mxCell>
        <mxCell id="23" value="THAY ĐỔI&#xa;Pause / resume / cancel / renew: SELECT FOR UPDATE, kiểm tra trạng thái, ghi DB và commit; cập nhật / xóa cache sau commit.&#xa;/renew là đồng bộ, không phát InvoiceIssued." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a5b2c2;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="600" y="640" width="505" height="175" as="geometry" />
        </mxCell>
        <mxCell id="24" value="LỖI &amp; CẤU HÌNH&#xa;400 validation / malformed; 404 không tìm thấy; 409 chuyển trạng thái không hợp lệ; 500 lỗi nội bộ.&#xa;/renewals cần outbox + Billing: thiếu cấu hình hoặc quote lỗi → 503." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a5b2c2;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1160" y="640" width="505" height="175" as="geometry" />
        </mxCell>
        <mxCell id="25" value="Subscription: Active → Paused → Active; có thể hủy nếu chưa Canceled. Mặc định cache TTL 5 phút; Redis không cấu hình → cache bộ nhớ tiến trình." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#203247;fontStyle=0;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="45" y="865" width="1620" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
