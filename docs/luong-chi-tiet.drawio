        <mxCell id="7" value="RabbitMQ&#xa;volume bền vững" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=0;fillColor=#fff1dd;strokeColor=#cc8122;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="8" value="MIGRATOR&#xa;Advisory lock; V1–V6 theo thứ tự&#xa;Kiểm tra checksum; mỗi migration transaction" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f3f5f8;strokeColor=#8291a3;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="155" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="9" value="BILLING&#xa;Chờ billing DB + RabbitMQ&#xa;Khởi tạo schema riêng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f0eafa;strokeColor=#8055a6;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="350" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="10" value="PAYMENTS&#xa;Chờ payments DB + RabbitMQ&#xa;Khởi tạo schema riêng" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f0eafa;strokeColor=#8055a6;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="520" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="11" value="API&#xa;Chờ DB, Redis, migrator hoàn tất&#xa;và Billing; cấu hình gRPC + outbox" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e8f1ff;strokeColor=#3973b7;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="215" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="12" value="RELAY&#xa;Chờ DB, RabbitMQ, migrator và API&#xa;Dùng subscriptions DB" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#fff1dd;strokeColor=#cc8122;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1220" y="300" width="325" height="110" as="geometry" />
        </mxCell>
        <mxCell id="13" value="chờ DB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="14" value="billing DB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="5" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="15" value="chờ broker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="7" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="16" value="chờ broker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="7" target="10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="17" value="hoàn tất" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="8" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="18" value="chờ Redis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.2;entryY=1;" edge="1" parent="1" source="6" target="11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="19" value="chờ Billing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0.5;entryY=1;" edge="1" parent="1" source="9" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" value="chờ API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" value="Payments cũng chờ payments DB. Relay chờ DB, migrator và RabbitMQ; mũi tên trên chỉ nhấn mạnh đường khởi động chính." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#203247;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="650" width="1550" height="45" as="geometry" />
        </mxCell>
        <mxCell id="22" value="OBSERVABILITY&#xa;OTLP chỉ xuất khi cấu hình endpoint. Aspire có dashboard; tùy chọn Collector → Prometheus / Tempo / Loki → Grafana. API: live = process, ready = database, /health = database + cache." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a5b2c2;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="725" width="710" height="150" as="geometry" />
        </mxCell>
        <mxCell id="23" value="DEPLOY &amp; GIỚI HẠN&#xa;Compose / Helm: API + migrator + PostgreSQL + Redis; không có Billing / Payments / Relay. Endpoint chưa có authentication/authorization; topology này dành cho môi trường tin cậy, không phải cấu hình production hoàn chỉnh." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a5b2c2;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="725" width="745" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
