        <mxCell id="16" value="SUBSCRIPTION" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#203247;fontStyle=1;spacing=0;" parent="1" vertex="1">
