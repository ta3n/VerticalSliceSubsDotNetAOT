            <Array as="points">
              <mxPoint x="535" y="760" />
              <mxPoint x="1320" y="760" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="23" value="CancelPayment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="9" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="24" value="LỖI TẠM THỜI&#xa;Lỗi HTTP / database được cấu hình sẽ retry; không biến thành rejection nghiệp vụ. Sau retry có thể vào dead letter. Timeout chỉ xử lý AwaitingPayment, không bù trừ Settling: có thể cần operator replay." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a5b2c2;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="845" width="1600" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-5" name="05 · Hủy và hoàn tiền">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="05 · Hủy và hoàn tiền" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=28;fontColor=#17365a;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1710" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Choreography dựa trên fact; cancellation và settlement dùng cùng khóa subscription để xử lý race." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#52677d;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1710" height="30" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Nguồn: src/SubscriptionManagement/Features/Subscriptions/CancelSubscriptions/ và Features/Invoices/SettleInvoice/; src/SubscriptionManagement.Relay/Features/Outbox/; src/SubscriptionManagement.Payments/Features/Payments/; src/SubscriptionManagement.Billing/Features/CreditNotes/" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#52677d;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1710" height="42" as="geometry" />
        </mxCell>
        <mxCell id="5" value="1 · DELETE /subscriptions/{id}&#xa;Khóa subscription, chuyển Canceled" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e8f1ff;strokeColor=#3973b7;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="285" height="105" as="geometry" />
        </mxCell>
        <mxCell id="6" value="2 · CÓ PAYMENT ĐÃ THU?&#xa;Outbox bật và invoice có payment_id&#xa;→ SubscriptionCanceled cùng transaction" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e5f5ec;strokeColor=#31865c;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="170" width="315" height="105" as="geometry" />
        </mxCell>
        <mxCell id="7" value="3 · RELAY + RabbitMQ&#xa;Publish SubscriptionCanceled&#xa;qua durable envelope" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#fff1dd;strokeColor=#cc8122;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="170" width="295" height="105" as="geometry" />
        </mxCell>
        <mxCell id="8" value="4 · PAYMENTS&#xa;Tìm snapshot theo subscription;&#xa;chọn Captured và PeriodEnd &gt; CanceledOn" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f0eafa;strokeColor=#8055a6;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="160" width="335" height="125" as="geometry" />
        </mxCell>
        <mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="12" value="5 · MARTEN TRANSACTION&#xa;Append ChargeRefunded toàn bộ amount&#xa;+ cập nhật snapshot + PaymentRefunded" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e5f5ec;strokeColor=#31865c;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="385" width="335" height="120" as="geometry" />
        </mxCell>
        <mxCell id="13" value="6 · BILLING&#xa;Nhận PaymentRefunded&#xa;Tạo credit note; unique payment_id&#xa;ON CONFLICT DO NOTHING" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f0eafa;strokeColor=#8055a6;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="385" width="295" height="120" as="geometry" />
        </mxCell>
        <mxCell id="14" value="mỗi payment đủ điều kiện" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="8" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="15" value="PaymentRefunded qua RabbitMQ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#52677d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#203247;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="16" value="RACE: SETTLEMENT ĐẾN MUỘN&#xa;Nếu chưa có payment_id khi hủy thì không phát fact ngay. Nếu đã cancel trước settlement, lần settlement thành công đầu tiên cũng ghi SubscriptionCanceled trong transaction. CanceledOn trong fact này là ngày settlement, không phải ngày hủy gốc; settlement lặp lại không ghi fact lần nữa." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#fff1dd;strokeColor=#cc8122;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="695" height="155" as="geometry" />
        </mxCell>
        <mxCell id="17" value="IDEMPOTENCY &amp; PHẠM VI&#xa;Charge lặp cho stream đã tồn tại là no-op; cancel trước charge có thể tạo stream ChargeCanceled để ngăn thu sau đó. Không refund theo tỷ lệ; /pay thủ công không tự tham gia choreography này." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a5b2c2;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="590" width="695" height="155" as="geometry" />
        </mxCell>
        <mxCell id="18" value="Không có coordinator hoàn tiền riêng; PaymentRefunded cũng có thể xuất hiện từ CancelPayment trong luồng bù trừ saga. Xem credit note qua GET /credit-notes?subscriptionId=… của Billing." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#203247;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="825" width="1550" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
