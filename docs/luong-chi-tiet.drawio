          <mxGeometry x="1180" y="125" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9" value="COMPENSATED&#xa;InvoiceSettlementRejected&#xa;→ CancelPayment" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#ffeded;strokeColor=#c75050;strokeWidth=2;fontColor=#203247;fontFamily=Helvetica;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
