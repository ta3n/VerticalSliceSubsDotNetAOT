<Project Sdk="Microsoft.NET.Sdk">

    <!-- Bitwarden Secrets Manager client for the JIT services (Billing, Payments, Relay). Its own project because the
         Bitwarden SDK is native and must stay out of the API, which is published as Native AOT. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Aspire.Bitwarden.SecretManager" Version="13.6.1"/>
    </ItemGroup>

</Project>
