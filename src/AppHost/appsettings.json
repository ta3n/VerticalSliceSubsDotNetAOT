{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Postgres": {
    "MaxConnections": 1000
  },
  "Api": {
    "PostgresMaxPoolSize": 900,
    "OutboxEnabled": true
  },
  "Services": {
    "PostgresMaxPoolSize": 20
  },
  "Billing": {
    "RenewalTimeoutSeconds": 30,
    "TaxRate": "0.10"
  },
  "Gateway": {
    "DeclineAtOrAbove": "5000",
    "NoReplyAtOrAbove": "9000"
  },
  "Relay": {
    "PollIntervalMs": 250,
    "BatchSize": 100
  },
  "Observability": {
    "Enabled": true,
    "GrafanaPort": 3000,
    "PrometheusPort": 9190,
    "PrometheusRetention": "7d"
  },
  "LoadTest": {
    "AutoStart": "",
    "load": {
      "VUS": "2000",
      "DURATION": "20s"
    },
    "stress": {
      "VUS": "2000",
      "DURATION": "60s"
    },
    "saga": {
      "ITERATIONS": "3",
      "RENEWAL_TIMEOUT_S": "30"
    }
  }
}
