{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Replicas": 2,
  "Postgres": {
    "MaxConnections": 1000,
    "Standbys": 2
  },
  "PgBouncer": {
    "Enabled": true,
    "PoolSize": 400,
    "MaxClientConnections": 10000,
    "MaxPreparedStatements": 200
  },
  "Api": {
    "PostgresMaxPoolSize": 1000,
    "OutboxEnabled": true
  },
  "Services": {
    "PostgresMaxPoolSize": 10
  },
  "Keycloak": {
    "Enabled": true
  },
  "Kafka": {
    "Enabled": true
  },
  "Bitwarden": {
    "Enabled": false
  },
  "Kubernetes": {
    "Enabled": false,
    "Namespace": "subscriptions"
  },
  "Billing": {
    "RenewalTimeoutSeconds": 30,
    "TaxRate": "0.10"
  },
  "Gateway": {
    "DeclineAtOrAbove": "5000",
    "NoReplyAtOrAbove": "9000"
  },
  "Relay": {
    "PollIntervalMs": 250,
    "BatchSize": 100
  },
  "Observability": {
    "Enabled": true,
    "GrafanaPort": 3000,
    "PrometheusPort": 9190,
    "PrometheusRetention": "7d"
  },
  "LoadTest": {
    "AutoStart": "",
    "load": {
      "VUS": "2000",
      "DURATION": "20s"
    },
    "stress": {
      "VUS": "2000",
      "DURATION": "60s"
    },
    "saga": {
      "ITERATIONS": "3",
      "RENEWAL_TIMEOUT_S": "30"
    },
    "breakpoint": {
      "BP_VUS": "1500",
      "BP_MAX_VUS": "3000"
    },
    "mq": {
      "MQ_FLOWS": "2500",
      "MQ_VUS": "100",
      "MQ_SETTLE_S": "180"
    }
  }
}
