{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Postgres": {
    "MaxConnections": 1000
  },
  "Api": {
    "PostgresMaxPoolSize": 900
  },
  "Observability": {
    "Enabled": true,
    "GrafanaPort": 3000,
    "PrometheusPort": 9190,
    "PrometheusRetention": "7d"
  },
  "LoadTest": {
    "AutoStart": "",
    "load": {
      "VUS": "2000",
      "DURATION": "20s"
    },
    "stress": {
      "VUS": "2000",
      "DURATION": "60s"
    }
  }
}
