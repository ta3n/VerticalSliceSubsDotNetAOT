{
  "uid": "subs-aspire-request-flow",
  "title": "Subscription Management — Request flow",
  "description": "How a request travels between the services: service graph, per-edge and per-operation RED metrics from Tempo's metrics generator, messaging backlog, traces and logs (Aspire AppHost).",
  "tags": [
    "subscription-management",
    "aspire"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(traces_spanmetrics_calls_total, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "sort": 1,
        "regex": "",
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "invoice_id",
        "label": "Invoice id",
        "description": "Invoice id returned by POST /subscriptions/{id}/renewals (= renewal saga id).",
        "type": "textbox",
        "query": "",
