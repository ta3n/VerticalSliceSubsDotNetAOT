      },
      "panels": [],
      "description": "Check message delivery, broker backlog, and Wolverine durable queues."
    },
    {
      "type": "timeseries",
      "title": "Messages sent / handled by type",
      "description": "Messages per second by type: sent uses Wolverine producer spans; handled uses Wolverine internal handler spans, which carry messaging.message_type. RabbitMQ consumer spans show delivery and carry queue names instead. A growing gap between sent and handled can indicate backlog, failures, or a stopped consumer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, messaging_message_type) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_PRODUCER\", messaging_message_type!=\"\"}[$__rate_interval]))",
          "legendFormat": "sent · {{service}} · {{messaging_message_type}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, messaging_message_type) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_INTERNAL\", messaging_message_type!=\"\"}[$__rate_interval]))",
          "legendFormat": "handled · {{service}} · {{messaging_message_type}}",
          "range": true,
          "refId": "B"
