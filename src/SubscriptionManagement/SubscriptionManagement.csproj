<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <!-- Analyzers run on every build, not only on publish. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <StripSymbols>true</StripSymbols>
    <!-- Keep ASP.NET Core's launch profile behaviour; only HTTP is served (TLS terminates at the ingress). -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SubscriptionManagement.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
