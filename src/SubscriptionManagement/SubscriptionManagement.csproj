<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <PublishAot>true</PublishAot>
        <!-- Analyzers run on every build, not only on publish. -->
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <StripSymbols>true</StripSymbols>
        <!-- Generate the minimal-API request delegates at build time regardless of PublishAot, so a JIT publish
             (-p:PublishAot=false) runs exactly the same reflection-free code as the native build. -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SubscriptionManagement.UnitTests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SubscriptionManagement.Contracts\SubscriptionManagement.Contracts.csproj"/>
        <ProjectReference Include="..\SubscriptionManagement.ServiceDefaults\SubscriptionManagement.ServiceDefaults.csproj"/>
    </ItemGroup>

    <!-- gRPC client for Billing, generated at build time (no reflection): the contract lives in Contracts. -->
    <ItemGroup>
        <Protobuf Include="..\SubscriptionManagement.Contracts\Protos\billing.proto" Link="Protos\billing.proto" GrpcServices="Client"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.36.2"/>
        <PackageReference Include="Grpc.Net.ClientFactory" Version="2.85.0"/>
        <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12"/>
        <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12"/>
        <PackageReference Include="Npgsql" Version="10.0.3"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.11"/>
    </ItemGroup>

</Project>
