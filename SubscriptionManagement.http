# Chạy API: dotnet run --launch-profile http
# Dùng REST Client (VS Code) hoặc HTTP Client của Visual Studio.
# Chạy lần lượt các request 1–5; các request còn lại chạy độc lập.
# Database nằm trong memory: chạy lại request 1 sau khi khởi động lại API.
@baseUrl = http://localhost:5127
@subscriptionId = {{createSubscription.response.body.$.id}}
@missingSubscriptionId = 00000000-0000-0000-0000-000000000000

### 1. Tạo subscription có dùng thử — 201 Created, status = 1 (Active)
# @name createSubscription
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{
  "serviceName": "Netflix",
  "price": 99000,
  "startDate": "2026-09-05",
  "trialEndsAt": "2026-09-12"
}

### 2. Xem subscription vừa tạo — 200 OK, status = 1 (Active)
GET {{baseUrl}}/subscriptions/{{subscriptionId}}
Accept: application/json

### 3. Hủy subscription — 204 No Content
DELETE {{baseUrl}}/subscriptions/{{subscriptionId}}

### 4. Xem sau khi hủy — 200 OK, status = 2 (Canceled)
GET {{baseUrl}}/subscriptions/{{subscriptionId}}
Accept: application/json

### 5. Hủy lại — 400 Bad Request, error = "Subscription already canceled."
DELETE {{baseUrl}}/subscriptions/{{subscriptionId}}

### 6. Tạo subscription không dùng thử — 201 Created
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{
  "serviceName": "Spotify",
  "price": 59000,
  "startDate": "2026-09-05",
  "trialEndsAt": null
}

### 7. Tên dịch vụ rỗng — 400 Bad Request
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{
  "serviceName": "",
  "price": 99000,
  "startDate": "2026-09-05",
  "trialEndsAt": null
}

### 8. Tên dịch vụ vượt quá 100 ký tự — 400 Bad Request
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{
  "serviceName": "This service name is intentionally longer than one hundred characters to test the maximum length validation.",
  "price": 99000,
  "startDate": "2026-09-05",
  "trialEndsAt": null
}

### 9. Giá bằng 0 — 400 Bad Request (giá phải lớn hơn 0)
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{
  "serviceName": "Netflix",
  "price": 0,
  "startDate": "2026-09-05",
  "trialEndsAt": null
}

### 10. Ngày hết dùng thử bằng ngày bắt đầu — 400 Bad Request
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{
  "serviceName": "Netflix",
  "price": 99000,
  "startDate": "2026-09-05",
  "trialEndsAt": "2026-09-05"
}

### 11. Xem subscription không tồn tại — 404 Not Found
GET {{baseUrl}}/subscriptions/{{missingSubscriptionId}}
Accept: application/json

### 12. Hủy subscription không tồn tại — 404 Not Found
DELETE {{baseUrl}}/subscriptions/{{missingSubscriptionId}}
