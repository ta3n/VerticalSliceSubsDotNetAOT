# Run the stack:  docker compose up --build            (API on :8080)
#   or locally:   docker compose up -d postgres redis && dotnet run --project src/SubscriptionManagement.Migrator -- \
#                   "Host=localhost;Database=subscriptions;Username=subs;Password=subs-dev-only" \
#                 && dotnet run --project src/SubscriptionManagement --launch-profile http   (API on :5127)
# Use REST Client (VS Code) or the Visual Studio HTTP client. Run requests 1-5 in order; the rest are independent.
@baseUrl = http://localhost:5127
@subscriptionId = {{createSubscription.response.body.$.id}}
@invoiceId = {{renew.response.body.$.invoice.id}}
@missingId = 00000000-0000-0000-0000-000000000000

### 1. Create a subscription with a trial - 201 Created, status = 1 (Active)
# @name createSubscription
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{ "serviceName": "Netflix", "price": 99000, "startDate": "2026-09-05", "trialEndsAt": "2026-09-12" }

### 2. Read it back (served from Redis after create) - 200 OK
GET {{baseUrl}}/subscriptions/{{subscriptionId}}

### 3. Pause - 200 OK, status = 3 (Paused)
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/pause

### 4. Pause again - 409 Conflict (invalid-subscription-transition)
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/pause

### 5. Resume - 200 OK, status = 1
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/resume

### 6. Renew - 200 OK, advances the billing period and issues an OPEN invoice
# @name renew
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/renew

### 7. List the subscription's invoices (newest first)
GET {{baseUrl}}/subscriptions/{{subscriptionId}}/invoices

### 8. Pay the invoice - 200 OK; paying again is 409 (invoice-not-payable)
POST {{baseUrl}}/invoices/{{invoiceId}}/pay

### 9. Search with keyset pagination (all body fields optional) - use nextCursor as "cursor" for the next page
POST {{baseUrl}}/subscriptions/search
Content-Type: application/json

{ "status": "ACTIVE", "limit": 10 }

### 10. Cancel - 204 No Content (row is kept, status = 2)
DELETE {{baseUrl}}/subscriptions/{{subscriptionId}}

### 11. Cancel again - 400 (problem+json; detail and "error" = "Subscription already canceled.")
DELETE {{baseUrl}}/subscriptions/{{subscriptionId}}

### 12. Validation - 400 problem+json with an "errors" map keyed by field name
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{ "serviceName": "", "price": 0, "startDate": "2026-09-05", "trialEndsAt": "2026-09-05" }

### 13. Unknown subscription - 404 problem+json
GET {{baseUrl}}/subscriptions/{{missingId}}

### 14. Plans catalog (seeded: free, pro-monthly, pro-yearly)
GET {{baseUrl}}/plans

### 15. Create a plan - 201; the same code again is 409
POST {{baseUrl}}/plans
Content-Type: application/json

{ "code": "team", "name": "Team", "amount": 49, "currency": "USD", "interval": "MONTH", "trialDays": 7 }

### 16. Get a plan
GET {{baseUrl}}/plans/team

### 17. Health: liveness / readiness (database) / everything (database + cache)
GET {{baseUrl}}/health/live
###
GET {{baseUrl}}/health/ready
###
GET {{baseUrl}}/health

### 18. OpenAPI document and Scalar UI (Development, or OpenApi__Enabled=true)
GET {{baseUrl}}/openapi/v1.json
