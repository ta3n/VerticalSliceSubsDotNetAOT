# Test-script settings for the compose stack (`podman compose up -d --build`, API on :8080).
#   ENV_FILE=scripts/.env.compose scripts/load-test.sh
CONTAINER_ENGINE=podman
BASE_URL=http://localhost:8080
VUS=50
DURATION=20s
LEVELS="100 250 500 1000 2000 4000 8000"
USERS=200
SPAWN_RATE=100
RUN_TIME=60s
