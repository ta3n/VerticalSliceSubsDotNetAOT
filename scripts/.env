# Test-script settings for the LOCAL KUBERNETES stack (kind + Kong + Helm; `task up`, see README "Kubernetes").
# Read by scripts/load-test.sh, stress-test.sh and locust-test.sh (through scripts/env.sh) and by Taskfile.yml (dotenv).
# Variables already set in the environment win:   VUS=200 scripts/load-test.sh
# Against docker/podman compose instead:          ENV_FILE=scripts/.env.compose scripts/load-test.sh
# Format: KEY=VALUE, comments on their own line.

# Docker daemon that hosts the kind cluster and the local registry (`docker context ls`). The k6/Locust containers
# must run on it too: their `--network host` has to be the machine where Kong is published.
DOCKER_CONTEXT=default
CONTAINER_ENGINE=docker

# Kong proxy, published on 127.0.0.1:9080 by kind's extraPortMappings or by `task kong:port-forward`. The local ingress
# has a host-less rule, so no Host header is needed. For heavy runs on a cluster without the port mapping, skip
# kubectl port-forward and hit the node's NodePort directly (Linux hosts reach kind node IPs):
#   BASE_URL=http://$(docker inspect -f '{{.NetworkSettings.Networks.kind.IPAddress}}' kind-control-plane):30080
BASE_URL=http://127.0.0.1:9080

# k6: load-test.sh (per scenario) and stress-test.sh (VU ladder). Two 256Mi API replicas on a laptop: keep the
# ladder modest, the default 8000-VU top rung mostly measures kind's networking.
VUS=2000
DURATION=20s
LEVELS="100 250 500 1000 2000"

# Locust (locust-test.sh)
USERS=200
SPAWN_RATE=100
RUN_TIME=60s
PROCESSES=1
