# Test-script settings for the Aspire AppHost (`task aspire`, API on :5127). k6 also remote-writes its metrics to the
# AppHost's Prometheus, so runs show up in Grafana (http://localhost:3000) on the "Load test" dashboard.
#   ENV_FILE=scripts/.env.aspire scripts/k6-test.sh smoke        # or spike, soak, rampup, breakpoint, contention, pagination, saga
#   ENV_FILE=scripts/.env.aspire scripts/load-test.sh
#   ENV_FILE=scripts/.env.aspire LEVELS="100 500 1000" scripts/stress-test.sh
# Scenario knobs (SPIKE_VUS, SOAK_DURATION, BP_MAX_RATE, ...) are documented in each scripts/*-test.js header; set
# them here or on the command line.
# k6 runs with --network host, which reaches the host's localhost with Podman or Docker Engine. With Docker Desktop use
# CONTAINER_ENGINE=docker and host.docker.internal instead of localhost in the URLs below.
CONTAINER_ENGINE=podman
BASE_URL=http://localhost:5127
BILLING_URL=http://localhost:5128
PAYMENTS_URL=http://localhost:5129
# Saga knobs: ITERATIONS defaults to 3; RENEWAL_TIMEOUT_S must match Billing:RenewalTimeoutSeconds in AppHost.
RENEWAL_TIMEOUT_S=30
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9190/api/v1/write
VUS=2000
DURATION=20s
LEVELS="100 250 500 1000 2000"
USERS=200
SPAWN_RATE=100
RUN_TIME=60s
