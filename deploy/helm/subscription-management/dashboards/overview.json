    {
      "type": "timeseries",
      "id": 9,
      "title": "Latency: API (p50/p95/p99) vs gateway total (p95)",
      "description": "API: OTel http.server.request.duration (exemplars link to Tempo). Gateway: Kong prometheus plugin; total includes the upstream (API) time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"subscription-management\", k8s_namespace_name=\"__NAMESPACE__\"}[$__rate_interval])))",
          "legendFormat": "API p50",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"subscription-management\", k8s_namespace_name=\"__NAMESPACE__\"}[$__rate_interval])))",
          "legendFormat": "API p95",
          "refId": "B",
          "range": true,
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"subscription-management\", k8s_namespace_name=\"__NAMESPACE__\"}[$__rate_interval])))",
          "legendFormat": "API p99",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kong_request_latency_ms_bucket{service=~\"__NAMESPACE__\\\\..*\"}[$__rate_interval]))) / 1000",
          "legendFormat": "gateway total p95",
          "refId": "D",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kong_kong_latency_ms_bucket{service=~\"__NAMESPACE__\\\\..*\"}[$__rate_interval]))) / 1000",
          "legendFormat": "gateway overhead p95",
          "refId": "E",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
